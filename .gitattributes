# 默认：自动识别文本文件，仓库内统一 LF
* text=auto eol=lf

# 源码
*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf
*.s    text eol=lf
*.ld   text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.ini  text eol=lf
*.ioc  text eol=lf

# Windows 脚本保持 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制
*.bin  binary
*.hex  binary
*.elf  binary
*.pdf  binary
*.png  binary
*.jpg  binary
