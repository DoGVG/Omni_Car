{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "烧录 ST-Link",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-s", "D:/vs-stm32-toolchain/OpenOCD-20260302-0.12.0/share/openocd/scripts",
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32f4x.cfg",
                "-c", "program build/Debug/omni_wheel_car.elf verify reset exit"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "构建",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "烧录 DAP-Link",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-s", "D:/vs-stm32-toolchain/OpenOCD-20260302-0.12.0/share/openocd/scripts",
                "-f", "interface/cmsis-dap.cfg",
                "-f", "target/stm32f4x.cfg",
                "-c", "program build/Debug/omni_wheel_car.elf verify reset exit"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "构建",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
